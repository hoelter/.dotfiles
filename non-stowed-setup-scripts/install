#!/usr/bin/env bash

cd $HOME/.dotfiles

# Clean symlinks if they exist
for dir in "$@"; do
    stow -v --delete $dir
done

# Create the symlinks
# --no-folding stows files individually instead of symlinking whole
# directories, so real dirs are created and nothing gets folded into a
# single tree symlink.
for dir in "$@"; do
    stow -v --no-folding $dir
done

echo 'Replacing the .gitconfig in the home directory.'
cp ~/.dotfiles/non-stowed-copied-files/.gitconfig ~/.gitconfig

