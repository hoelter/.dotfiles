{
  "meta": {
    "name": "mac-base",
    "version": "1.0.0",
    "description": "Local development with Docker/Colima; local environment files and personal paths denied"
  },
  "extends": "mac-dev-common",

  "filesystem": {
    "allow": [
      "$HOME/.docker",
      "$HOME/.colima"
    ],

    "bypass_protection": [
      "$HOME/.docker",
      "$HOME/.colima"
    ],

    "unix_socket": [
      "$HOME/.colima/default/docker.sock"
    ]
  }
}
