{
  "meta": {
    "name": "mac-dev-common",
    "version": "1.0.0",
    "description": "Shared macOS development access with local credentials, environment files, and personal paths denied"
  },
  "extends": "default",

  "groups": {
    "include": [
      "node_runtime",
      "python_runtime",
      "unlink_protection"
    ],
    "exclude": [
      "dangerous_commands",
      "dangerous_commands_macos"
    ]
  },

  "filesystem": {
    "read": [
      "/usr/local/share/dotnet",
      "/etc/dotnet",
      "$HOME/.config/mise",
      "$HOME/.gitignore"
    ],

    "allow": [
      "$HOME/my-repos",
      "$HOME/other-repos",
      "$HOME/.dotfiles",
      "$HOME/.dotfiles-personal",

      "$HOME/.dotnet",
      "$HOME/.nuget/packages",
      "$HOME/.local/share/NuGet",
      "$HOME/Library/Caches/NuGet",

      "$HOME/.local/share/mise",
      "$HOME/.local/state/mise",
      "$HOME/.cache/mise",

      "$HOME/.cache/uv",
      "$HOME/.local/share/uv",
      "$HOME/.npm"
    ],

    "deny": [
      "$HOME/Documents",
      "$HOME/Downloads",
      "$HOME/Pictures",
      "$HOME/Desktop",
      "$HOME/Applications",
      "$HOME/Music",
      "$HOME/.notes",

      "$WORKDIR/.env",
      "$WORKDIR/.env.local",
      "$WORKDIR/.env.development.local",
      "$WORKDIR/.env.test.local",
      "$WORKDIR/.env.staging.local",
      "$WORKDIR/.env.production.local"
    ]
  },

  "environment": {
    "deny_vars": [
      "AWS_ACCESS_KEY_ID",
      "AWS_SECRET_ACCESS_KEY",
      "AWS_SESSION_TOKEN",
      "AZURE_CLIENT_SECRET",
      "GH_TOKEN",
      "GITHUB_TOKEN",
      "GITLAB_TOKEN",
      "NPM_TOKEN",
      "DATABASE_URL"
    ],
    "set_vars": {
      "EDITOR": "$HOME/.local/bin/nvim-agent",
      "VISUAL": "$HOME/.local/bin/nvim-agent"
    }
  },

  "network": {
    "block": false
  }
}
