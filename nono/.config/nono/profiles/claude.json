{
  "meta": {
    "name": "claude",
    "version": "1.0.0",
    "description": "Claude with local development access and Claude settings"
  },
  "extends": [
    "mac-base",
    "nolabs-ai/claude"
  ],

  "filesystem": {
    "allow": [
      "$HOME/.claude"
    ],
    "allow_file": [
      "$HOME/.claude.json"
    ],
    "suppress_save_prompt": [
      "$HOME",
      "/home",
      "$HOME/Applications/Claude Code URL Handler.app"
    ]
  },

  "unsafe_macos_seatbelt_rules": [
    "(allow file-write* (regex \"^/Users/chris/\\.claude\\.json\\.tmp\\.[^/]+$\"))"
  ]
}
